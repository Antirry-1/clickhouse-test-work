# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` (the Makefile / docker compose read it automatically):
#     cp .env.example .env
# All values below are safe local-demo defaults. Change credentials for any real use.
# ─────────────────────────────────────────────────────────────────────────────

# ---- ClickHouse ----
CLICKHOUSE_IMAGE_TAG=24.8
CLICKHOUSE_DB=sms
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# ---- Apache Superset ----
# Any 4.x tag works; if this tag is missing in your registry, change it here only.
SUPERSET_IMAGE_TAG=4.1.1
SUPERSET_PORT=8088
SUPERSET_ADMIN=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_EMAIL=admin@example.com
# Change this for anything beyond a local demo:
SUPERSET_SECRET_KEY=CHANGE_ME_local_dev_secret_key_0123456789abcdef

# ---- Data generator ----
GEN_ROWS=1000000
GEN_START=2025-01-01
GEN_END=2026-01-01
GEN_BATCH=50000
GEN_SEED=42

# ---- Optional: Jira (only for `make smoke-test-with-jira`) ----
# Files a Jira issue when the smoke test fails. Leave blank to skip — the stack
# needs none of this. Create an API token at id.atlassian.com; put the REAL token
# in your local .env only (it is gitignored). Never commit a real token.
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=SMS
JIRA_ISSUE_TYPE=Bug
